# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.dev.log

# licensed third-party art (Cute Fantasy Free): never commit, see docs/assets.md
/public/licensed/
*.zip

# manual account backups exported from the app contain personal balances: never commit
finance-town-accounts-*.json

# encrypted Plaid access token (server-only, see docs/plaid.md): never commit
/.data/
