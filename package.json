{
  "name": "finance-town",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/with-node24.sh next dev -p 3000",
    "build": "bash scripts/with-node24.sh next build",
    "start": "bash scripts/with-node24.sh next start",
    "lint": "bash scripts/with-node24.sh eslint",
    "test": "bash scripts/with-node24.sh vitest run",
    "typecheck": "bash scripts/with-node24.sh tsc --noEmit",
    "dev:stop": "bash scripts/dev-stop.sh 3000",
    "install:locked": "bash scripts/with-node24.sh npm ci",
    "node:check": "bash scripts/with-node24.sh node -p \"process.version+' '+process.execPath\""
  },
  "dependencies": {
    "next": "16.4.3",
    "phaser": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
