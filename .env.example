# Finance Town local settings. This file is a template with NO real values.
#
# Setup (do it in your own editor; never paste these values into chat, commits, issues or logs):
#   1. npm run env:init        (creates .env.local from this file, or appends missing empty placeholders; never overwrites)
#   2. Open .env.local in your editor and type the values after each "=".
#   3. Restart the dev server: npm run dev:stop && npm run dev
#
# SnapTrade Personal API key (read-only brokerage balances). Create it at
# https://dashboard.snaptrade.com/api-key and keep the consumer key server-side only.
# Personal keys need no userId or userSecret. Do not prefix these names with NEXT_PUBLIC_.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Local access code that unlocks live brokerage data in the browser. Make it up yourself, at
# least 12 characters (for example the output of: openssl rand -base64 24). Without it, live
# data stays off.
FINANCE_TOWN_ACCESS_CODE=

# Plaid (read-only BluPeak balances). Keys: https://dashboard.plaid.com/developers/keys
# PLAID_ENV is exactly "production" (real connections on the Trial plan) or "sandbox" (fake banks, never
# counted toward net worth). Nothing else is accepted. Each environment has its own saved-connection file.
PLAID_CLIENT_ID=
# Plaid issues a different secret per environment. Fill the one(s) you use; the one matching PLAID_ENV is picked
# automatically, so switching environments never needs a secret to be moved or retyped (see: npm run plaid:env).
PLAID_SECRET_PRODUCTION=
PLAID_SECRET_SANDBOX=
# Older single-secret form, still accepted when no per-environment secret is set.
PLAID_SECRET=
PLAID_ENV=

# School (read-only Canvas calendar feeds). In Canvas: Calendar > Calendar Feed, copy the private https link and
# paste it here yourself. Anyone with the link can read that calendar, so never share it or commit it. SDSU feeds must be on
# an sdsu.instructure.com or *.sdsu.edu host; SDCCD feeds on sdccd.instructure.com or *.sdccd.edu. Redirects are checked too.
CANVAS_SDSU_FEED_URL=
CANVAS_SDCCD_FEED_URL=

# Encrypts the saved Plaid access token (AES-256-GCM). Do not type this: run `npm run vault:key`, which
# generates it into .env.local without printing it. Keep a private backup; without it a saved connection is unreadable.
FINANCE_TOWN_DATA_KEY=

# Test-only switches (leave commented out for real use). Fixtures serve synthetic accounts and
# never contact SnapTrade; they are ignored when NODE_ENV is production.
# FINANCE_TOWN_BROKERAGE_FIXTURES=1
# FINANCE_TOWN_REFRESH_COOLDOWN_MS=60000
